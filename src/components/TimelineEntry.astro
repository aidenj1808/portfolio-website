---
interface Props {
  title: string;
  dates: string;
}

const { title, dates } = Astro.props;
---

<li class="relative pb-10 pl-6 last:pb-0">
  <span
    aria-hidden="true"
    class="absolute top-2.5 -left-[5px] size-[9px] rounded-full bg-accent ring-4 ring-bg"
  ></span>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="text-sm text-muted">{dates}</p>
  </div>
  <slot />
</li>
