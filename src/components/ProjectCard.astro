---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tech, cover, coverAlt } = project.data;
---

<article class="overflow-hidden rounded-lg border border-slate-200 transition hover:shadow-md">
  <a href={`/projects/${project.id}/`} class="block">
    <Image src={cover} alt={coverAlt} width={600} class="aspect-video w-full object-cover" />
    <div class="p-4">
      <h2 class="text-lg font-semibold">{title}</h2>
      <p class="mt-1 text-sm text-slate-600">{summary}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {tech.map((name) => (
          <li class="rounded bg-slate-100 px-2 py-0.5 text-xs">{name}</li>
        ))}
      </ul>
    </div>
  </a>
</article>
