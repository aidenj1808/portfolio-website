---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-border">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <a href="/" class="font-semibold hover:text-accent">
      {siteName}
    </a>
    <div class="flex items-center gap-6">
      <ul class="flex gap-6 text-sm">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'hover:text-accent',
                currentPath.startsWith(href) &&
                  'font-medium underline decoration-accent decoration-2 underline-offset-4',
              ]}
              aria-current={currentPath.startsWith(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
