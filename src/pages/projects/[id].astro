---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateRange } from '../../lib/dates';
import { getCoverPreviewImage } from '../../lib/preview-image';
import { getPublishedProjects, type Project } from '../../lib/projects';

/**
 * Generates one detail page per published project.
 *
 * @returns Route params keyed by project id, with the entry passed as a prop.
 */
export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tech, startDate, endDate, repo, demoUrl, cover, coverAlt } = project.data;
const { Content } = await render(project);
const previewImage = await getCoverPreviewImage(cover, coverAlt);
---

<BaseLayout title={title} description={summary} image={previewImage}>
  <article>
    <a href="/projects/" class="text-sm text-muted hover:text-fg">
      &larr; All projects
    </a>
    <h1 class="mt-4 text-3xl font-bold">{title}</h1>
    <p class="mt-2 text-muted">{formatDateRange(startDate, endDate)}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {tech.map((name) => (
        <li class="rounded bg-surface px-2 py-0.5 text-sm">{name}</li>
      ))}
    </ul>
    <div class="mt-4 flex gap-4 text-sm">
      {repo && (
        <a href={repo} class="underline underline-offset-4 hover:text-accent">
          Source code
        </a>
      )}
      {demoUrl && (
        <a href={demoUrl} class="underline underline-offset-4 hover:text-accent">
          Live demo
        </a>
      )}
    </div>
    <Image src={cover} alt={coverAlt} width={1200} class="mt-8 w-full rounded-lg" />
    <div class="project-content mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
